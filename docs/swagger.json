        "/qr-message/{qr_id}": {
            "post": {
                "description": "Saves the message and sends a Telegram notification to the owner if they have the bot linked.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "QR"
                ],
                "summary": "Send a message to the QR owner",
                "parameters": [
                    {
                        "type": "string",
                        "description": "QR code",
                        "name": "qr_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Message text (1–500 chars)",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/client.messageBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/qr-verify/{qr_id}": {
            "post": {
                "description": "Verifies the OTP, creates or links the user by phone,\nthen returns an access token valid for 30 days.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "QR"
                ],
                "summary": "Verify OTP and register the QR code",
                "parameters": [
                    {
                        "type": "string",
                        "description": "QR code",
                        "name": "qr_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Phone + OTP",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/client.verifyBody"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/qr/{qr_id}": {
            "get": {
                "description": "Returns the full owner profile and vehicle linked to this QR code.\nReturns {\"registered\":false} if the code is not yet claimed.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "QR"
                ],
                "summary": "Get QR code info",
                "parameters": [
                    {
                        "type": "string",
                        "description": "QR code",
                        "name": "qr_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            },
            "post": {
                "description": "Validates the QR code and sends a 6-digit OTP to the given phone number.\nThe OTP is valid for 5 minutes.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "QR"
                ],
                "summary": "Send OTP to phone number",
                "parameters": [
                    {
                        "type": "string",
                        "description": "QR code",
                        "name": "qr_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Phone number",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/client.registerBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/qr/{qr_id}/image": {
            "get": {
                "produces": [
                    "image/png"
                ],
                "tags": [
                    "QR"
                ],
                "summary": "Get QR code as PNG image",
                "parameters": [
                    {
                        "type": "string",
                        "description": "QR code",
                        "name": "qr_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "default": 256,
                        "description": "Image size in pixels",
                        "name": "size",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "admin.AdminLoginRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "example": "password123"
                },
                "username": {
                    "type": "string",
                    "example": "admin"
                }
            }
        },
        "admin.AdminLoginResponse": {
            "type": "object",
            "properties": {
                "admin_session": {
                    "type": "boolean",
                    "example": true
                },
                "tokens": {
                    "$ref": "#/definitions/admin.TokensResponse"
                }
            }
        },
        "admin.DataResponse": {
            "type": "object",
            "properties": {
                "data": {}
            }
        },
        "admin.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "error message"
                }
            }
        },
        "admin.GenerateQRRequest": {
            "type": "object",
            "required": [
                "count"
            ],
            "properties": {
                "count": {
                    "type": "integer",
                    "maximum": 1000,
                    "minimum": 1
                }
            }
        },
        "admin.MessageResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "operation successful"
                }
            }
        },
        "admin.PaginatedResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "limit": {
                    "type": "integer",
                    "example": 20
                },
                "page": {
                    "type": "integer",
                    "example": 1
                },
                "total": {
                    "type": "integer",
                    "example": 100
                }
            }
        },
        "admin.StatsResponse": {
            "type": "object",
            "properties": {
                "active_qr": {
                    "type": "integer"
                },
                "blocked_qr": {
                    "type": "integer"
                },
                "scans_today": {
                    "type": "integer"
                },
                "total_messages": {
                    "type": "integer"
                },
                "total_qr_codes": {
                    "type": "integer"
                },
                "total_users": {
                    "type": "integer"
                },
                "unregistered_qr": {
                    "type": "integer"
                }
            }
        },
        "admin.TokensResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs..."
                },
                "refresh_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs..."
                }
            }
        },
        "client.messageBody": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "client.patchMeBody": {
            "type": "object",
            "properties": {
                "avatar_url": {
                    "type": "string"
                },
                "facebook": {
                    "type": "string"
                },
                "first_name": {
                    "type": "string"
                },
                "instagram": {
                    "type": "string"
                },
                "last_name": {
                    "type": "string"
                },
                "telegram": {
                    "type": "string"
                },
                "vk": {
                    "type": "string"
                },
                "whatsapp": {
                    "description": "Socials: omit = skip, \"\" = delete, \"value\" = upsert",
                    "type": "string"
                }
            }
        },
        "client.patchVehicleBody": {
            "type": "object",
            "properties": {
                "car_model": {
                    "type": "string"
                },
                "photo_url": {
                    "type": "string"
