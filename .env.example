APP_NAME="qr-parking"
APP_ENV=development

# API (host 8090 — не пересекается с типичным 8080 / qr-parking)
SERVER_PORT=8090
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s

# Database (локально: порт 5434 → см. docker-compose)
DATABASE_URL=postgres://qrparking:qrparking@localhost:5434/qrparking?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h

# Redis (локально: порт 6380)
REDIS_URL=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

TG_BOT_TOKEN=your-telegram-bot-token
TG_WEBHOOK_URL=

APP_BASE_URL=http://localhost:8090
